{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**/*",
        "public/**/*",
        "plugboy.workspace.ts",
        "$TURBO_ROOT$/plugboy.project.ts"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {},
    "format": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx"
      ]
    },
    "test": {
      "inputs": [
        "src/**/*",
        "public/**/*",
        "**/__tests__/**/*"
      ]
    },
    "deploy": {
      "dependsOn": [
        "build",
        "test",
        "lint"
      ]
    }
  }
}
